<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vérifie que la couche Unity et l'exemple compilent, contre des bouchons de l'API Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>FomaPay.Unity</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityEngineStubs.cs" />
    <Compile Include="..\..\Runtime\Core\*.cs" />
    <Compile Include="..\..\Runtime\Unity\*.cs" />
    <Compile Include="..\..\Samples~\Shop\*.cs" />
  </ItemGroup>

</Project>
